{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/thmt-banner/banners.schema.json",
  "title": "THMT Banner Config V1",
  "type": "object",
  "required": ["schema_version","config_version","system","layout","asset_rules","brands"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "config_version": {"type":"string","minLength":1},
    "system": {
      "type":"object",
      "required":["enabled","rotation_interval_seconds","rotation_mode","github_sync_interval_seconds","fit_mode","allow_hide_controls"],
      "properties":{
        "enabled":{"type":"boolean"},
        "rotation_interval_seconds":{"type":"integer","minimum":1},
        "rotation_mode":{"enum":["sequential","random"]},
        "github_sync_interval_seconds":{"type":"integer","minimum":30},
        "media_base_url":{"type":"string","description":"Optional HTTPS CDN/R2 base URL. Empty/omitted uses the plugin default media origin."},
        "fit_mode":{"const":"contain"},
        "allow_hide_controls":{"const":false}
      },
      "additionalProperties":true
    },
    "brands":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "required":["id","name","enabled","url","assets"],
        "properties":{
          "id":{"type":"string","minLength":1},
          "name":{"type":"string","minLength":1},
          "enabled":{"type":"boolean"},
          "url":{"type":"string","description":"Để trống nếu chưa gắn link. Khi trống banner vẫn hiển thị nhưng không clickable."},
          "assets":{
            "type":"object",
            "required":["horizontal","vertical","middle"],
            "properties":{
              "horizontal":{"$ref":"#/$defs/asset"},
              "vertical":{"$ref":"#/$defs/asset"},
              "middle":{"$ref":"#/$defs/asset"}
            }
          }
        }
      }
    }
  },
  "$defs":{
    "asset":{
      "type":"object",
      "required":["file","size","compatibility"],
      "properties":{
        "file":{"type":"string","minLength":1},
        "size":{"type":"string","pattern":"^[0-9]{2,4}x[0-9]{2,4}$"},
        "compatibility":{"enum":["exact","fallback"]}
      }
    }
  }
}